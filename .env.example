# ---------------------------------------------------------------------------
# web-rateo environment variables
# Copy this file to .env.local and fill in the values.
# NOTHING that must stay private may be prefixed with NEXT_PUBLIC_ — that
# prefix inlines the value into the browser bundle.
# ---------------------------------------------------------------------------

# Rate'O backend REST base URL, INCLUDING the /api suffix.
# SERVER-ONLY. Read by src/lib/env.ts -> getApiBaseUrl() and used by the
# catch-all proxy (src/app/api/[...path]/route.ts) and server components.
# Never rename this to NEXT_PUBLIC_API_BASE_URL: the browser must never learn
# the backend origin, it always talks to same-origin /api/*.
API_BASE_URL=https://api-prod.rateo.ng/api

# Public origin this app is served from. Used for absolute URLs in Open Graph
# metadata, robots.txt and sitemap.xml.
# Local: http://localhost:3000 — Production: https://app.rateo.ng
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk — Google / Apple / LinkedIn social sign-in. Same Clerk instance as the
# Expo app (Clerk dashboard -> API keys).
#
# BOTH may be left empty: with no publishable key the app skips <ClerkProvider>,
# the "Continue with Google / Apple / LinkedIn" buttons render nothing,
# /sso-callback redirects to /login and POST /api/auth/social-login answers
# 503. `npm run build` passes either way.
#
# Publishable key. Public by design — Next inlines it into the browser bundle.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key. SERVER-ONLY: it is what lets `currentUser()` read the signed-in
# Clerk user inside /api/auth/social-login, and what turns on clerkMiddleware()
# in proxy.ts. Never prefix it with NEXT_PUBLIC_.
CLERK_SECRET_KEY=

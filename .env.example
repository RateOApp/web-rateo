# ---------------------------------------------------------------------------
# web-rateo environment variables
# Copy this file to .env.local and fill in the values.
# NOTHING that must stay private may be prefixed with NEXT_PUBLIC_ — that
# prefix inlines the value into the browser bundle.
# ---------------------------------------------------------------------------

# Rate'O backend REST base URL, INCLUDING the /api suffix.
# SERVER-ONLY. Read by src/lib/env.ts -> getApiBaseUrl() and used by the
# catch-all proxy (src/app/api/[...path]/route.ts) and server components.
# Never rename this to NEXT_PUBLIC_API_BASE_URL: the browser must never learn
# the backend origin, it always talks to same-origin /api/*.
API_BASE_URL=https://api-prod.rateo.ng/api

# Public origin this app is served from. Used for absolute URLs in Open Graph
# metadata, robots.txt and sitemap.xml.
# Local: http://localhost:3000 — Production: https://app.rateo.ng
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (Phase 3 — Google / Apple / LinkedIn social sign-in).
# Same Clerk instance as the Expo app. Leave empty until Phase 3.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
